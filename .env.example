# Agent Energy Bridge — 环境变量配置示例
# 复制此文件为 .env 并填写真实值

# ==========================================
# NewAPI 中转站配置（真实模式）
# ==========================================
NEWAPI_BASE_URL=http://your-newapi-server:3000
NEWAPI_API_KEY=your-api-key-here

# 可选：NewAPI 用户ID（管理API需要）
# NEWAPI_USER_ID=1

# 可选：用户名密码登录（v1.0.0+ 管理API）
# NEWAPI_USERNAME=admin
# NEWAPI_PASSWORD=your-password

# 可选：额度单位换算（默认 100000 quota = 1 USD）
# NEWAPI_QUOTA_PER_UNIT=100000

# ==========================================
# 演示模式配置（不设置 NEWAPI_BASE_URL 时生效）
# ==========================================
# DEMO_BALANCE_USD=5
# DEMO_DAILY_SPENT_USD=2
# DEMO_HOURLY_TOKENS=12000

# ==========================================
# 自动充值配置
# ==========================================
# AUTO_REFUEL_ENABLED=true
# AUTO_REFUEL_THRESHOLD_USD=3
# AUTO_REFUEL_AMOUNT_USD=10
# AUTO_REFUEL_STRATEGY=fixed
# AUTO_REFUEL_MAX_PER_HOUR=3
# AUTO_REFUEL_COOLDOWN_MS=60000
# AUTO_REFUEL_CODES=CODE1,CODE2,CODE3

# ==========================================
# 服务器配置
# ==========================================
# AEB_PORT=3100
# AEB_HOST=127.0.0.1
# AEB_LOG_LEVEL=info

# ==========================================
# 健康检查路由
# ==========================================
# HEALTH_CHECK_ROUTES=http://backup1.com,http://backup2.com
# HEALTH_CHECK_INTERVAL_MS=60000
# HEALTH_CHECK_TIMEOUT_MS=10000

# ==========================================
# Codex / OpenAI 兼容配置
# ==========================================
# 如果你的 NewAPI 支持 OpenAI 兼容接口，可以配置给 Codex CLI 使用：
# OPENAI_BASE_URL=http://your-newapi-server:3000/v1
# OPENAI_API_KEY=your-api-key-here
